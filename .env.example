# Copy to .env and point these at your course files.
# Relative paths start at this folder (the course files live outside the repo); absolute paths (e.g. D:/Courses/MLA-C01) also work.

# Folder holding the "NN - Section" folders with the .mp4 videos and _en/_vi .srt subtitles
COURSE_DIR=..
# Folder with the downloadable lab files (lecture "materials" paths are relative to it)
MATERIALS_DIR=../MLA-C02-Materials
# The course slides PDF offered under every lecture
SLIDES_FILE=../AWS-Certified-ML-Engineer-Associate-Slides.pdf
# SQLite file with accounts and each account's progress (created on first run)
DB_FILE=data/study.db
